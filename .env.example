# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data Mode: 'local' (zero Supabase required) or 'supabase' (hosted backend)
NEXT_PUBLIC_DATA_MODE=local

# Supabase Credentials (required only when NEXT_PUBLIC_DATA_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
